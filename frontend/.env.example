# Frontend environment example for local development
# Copy to .env.local or .env and fill real credentials in development

# Enable Google OAuth button (true/false)
VITE_ENABLE_GOOGLE_OAUTH=true

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8081

# Optional: frontend URL used by backend as success redirect
VITE_FRONTEND_URL=http://localhost:5173

# Example Google OAuth client settings (DO NOT commit real secrets to repo)
# These are used on the Google Cloud Console; set actual client ID/secret in the backend environment
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
# VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret
